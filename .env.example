# Copy to .env.local (never commit real values).
# Variables starting with VITE_ are PUBLIC (visible in the browser).
# Never put service-role keys, AI keys or payment secrets in VITE_ variables.

# Supabase (Project Settings > API). Needed from Batch 2 onward.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Supabase Edge Function secrets, NOT Vercel VITE_ vars).
# Needed from Phase 3/4:
# AI_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=